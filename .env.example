# Copiá este archivo a .env.local para desarrollo.
# En Vercel se cargan como Environment Variables.

# URL del backend (obligatoria en producción)
VITE_API_URL=http://localhost:3001

# Opcional: solo si el socket está en otra URL distinta de la API
# VITE_SOCKET_URL=http://localhost:3001

# Opcional: subida de imágenes (Cloudinary). Si no se definen se usan las del proyecto original.
# VITE_CLOUDINARY_CLOUD_NAME=
# VITE_CLOUDINARY_PRESET=
